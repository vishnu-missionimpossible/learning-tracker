rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function courseOf(id) {
      return get(/databases/$(database)/documents/courses/$(id)).data;
    }
    function isCourseOwner(id) {
      return courseOf(id).userId == request.auth.uid;
    }
    function isCourseMember(id) {
      return courseOf(id).userId == request.auth.uid
          || request.auth.uid in courseOf(id).memberIds;
    }

    // Each user can read/write only their own profile (daily goals live here)
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Public display name + avatar (no email stored here)
    match /profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 30;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /courses/{courseId} {

      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;

      // Owner, members and invited friends can read the course
      allow read: if signedIn() && (
                    resource.data.userId == request.auth.uid
                    || request.auth.uid in resource.data.memberIds
                    || request.auth.token.email.lower() in resource.data.invitedEmails
                  );

      allow update: if signedIn() && (
                    // owner: full control (invite, rename, soft-delete...)
                    resource.data.userId == request.auth.uid

                    // invited friend: accept the invite (adds only themselves)
                    || (request.auth.token.email.lower() in resource.data.invitedEmails
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['memberIds', 'memberEmails', 'invitedEmails', 'updatedAt'])
                        && request.auth.uid in request.resource.data.memberIds
                        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1)

                    // member: leave the course (removes only themselves; the owner cannot leave)
                    || (request.auth.uid in resource.data.memberIds
                        && request.auth.uid != resource.data.userId
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['memberIds', 'memberEmails', 'updatedAt'])
                        && !(request.auth.uid in request.resource.data.memberIds)
                        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1)

                    // invited friend: decline the invite (only removes their own email)
                    || (request.auth.token.email.lower() in resource.data.invitedEmails
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['invitedEmails', 'updatedAt']))
                  );

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /metrics/{metricId} {

      // Everyone in the course can see everyone's entries (needed for the leaderboard)
      allow read: if signedIn() && (
                    resource.data.userId == request.auth.uid
                    || isCourseMember(resource.data.courseId)
                  );

      // You can only add entries as yourself, to a course you belong to
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && isCourseMember(request.resource.data.courseId);

      // The author can edit an entry; any other course member may only set or remove
      // THEIR OWN emoji reaction on it
      allow update: if signedIn() && (
                    resource.data.userId == request.auth.uid
                    || (isCourseMember(resource.data.courseId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                        && request.resource.data.reactions.diff(resource.data.get('reactions', {}))
                             .affectedKeys().hasOnly([request.auth.uid])
                        && (!(request.auth.uid in request.resource.data.reactions)
                            || request.resource.data.reactions[request.auth.uid] in ['👏', '🔥', '💪', '🎉', '😂']))
                  );

      // Only the author can delete an entry
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Resource library: shared per course
    // ---------------------------------------------------------------
    match /resources/{resId} {
      allow read: if signedIn() && isCourseMember(resource.data.courseId);

      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && isCourseMember(request.resource.data.courseId)
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 150
                    && request.resource.data.url is string
                    && request.resource.data.url.size() <= 1500;

      allow update: if signedIn() && (
                    // adder or course owner: edit / pin (cannot move it to another course)
                    ((resource.data.userId == request.auth.uid || isCourseOwner(resource.data.courseId))
                      && request.resource.data.courseId == resource.data.courseId
                      && request.resource.data.userId == resource.data.userId)
                    // any member: only toggle THEIR OWN "helpful" vote / "done" mark
                    || (isCourseMember(resource.data.courseId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'doneBy'])
                        && request.resource.data.likes.diff(resource.data.likes).affectedKeys().hasOnly([request.auth.uid])
                        && request.resource.data.doneBy.diff(resource.data.doneBy).affectedKeys().hasOnly([request.auth.uid]))
                  );

      allow delete: if signedIn() && (resource.data.userId == request.auth.uid
                                      || isCourseOwner(resource.data.courseId));
    }

    // ---------------------------------------------------------------
    // Comments & group chat: shared per course
    // ---------------------------------------------------------------
    match /comments/{commentId} {
      allow read: if signedIn() && isCourseMember(resource.data.courseId);

      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && isCourseMember(request.resource.data.courseId)
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500;

      allow delete: if signedIn() && (resource.data.userId == request.auth.uid
                                      || isCourseOwner(resource.data.courseId));
    }

    // ---------------------------------------------------------------
    // Flashcards & weekly reflections: private to each user
    // ---------------------------------------------------------------
    match /flashcards/{cardId} {
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.front.size() <= 300
                    && request.resource.data.back.size() <= 1000;
    }

    match /reflections/{reflectionId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Study buddies
    // ---------------------------------------------------------------
    match /buddyPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.topic.size() > 0
                    && request.resource.data.topic.size() <= 60;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // One request per person per post (document id = postId_requesterUid)
    match /buddyRequests/{requestId} {
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid
                                    || resource.data.toUid == request.auth.uid);

      allow create: if signedIn()
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid != request.auth.uid
                    && requestId == request.resource.data.postId + '_' + request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.message.size() <= 300;

      // the post owner answers the request; nothing else may change
      allow update: if signedIn()
                    && resource.data.toUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                    && request.resource.data.status in ['accepted', 'declined', 'invited'];

      allow delete: if signedIn() && (resource.data.fromUid == request.auth.uid
                                      || resource.data.toUid == request.auth.uid);
    }
  }
}
